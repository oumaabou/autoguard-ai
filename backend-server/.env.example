GEMINI_API_KEY=your_gemini_api_key_here

# Optional automatic fallback provider when Gemini fails (see
# rag_engine.py's _generate()). Free key: https://console.groq.com/keys
GROQ_API_KEY=

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Get this from the Supabase dashboard: Project Settings -> API -> "service_role" secret.
# Needed for scripts/generate_embeddings.py (and used server-side by the backend itself).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
